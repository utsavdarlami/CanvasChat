# .env.example
# Copy this file to .env and fill in your details.

# The model name as recognized by litellm.
# See litellm documentation for a full list of supported models.
# Examples: "gemini/gemini-pro", "gpt-4", "claude-2"
LLM_MODEL="gemini/gemini-pro"

# Model used by the ADK layout chat agent (/api/chat and /api/chat/stream).
# This is independent from LLM_MODEL used by semantic extraction.
# AGENT_LLM_MODEL="gemini-3-flash-preview"
AGENT_LLM_MODEL="gemini-3-pro-preview"

AGENT_TEMPERATURE=0.2

LLM_TEMPERATURE=0.5

# LLM temperature for semantic extraction (0.0-1.0)
# Recommended: 0.1 for deterministic, consistent extraction of factual information
# Lower values = more consistent, higher values = more creative/varied
# LLM_TEMPERATURE=0.1

# Fast model for /api/chat/autocomplete
# Should be low-latency and low-cost compared to the main chat model.
AUTOCOMPLETE_MODEL="gemini/gemini-2.0-flash"

# Temperature for autocomplete suggestions
AUTOCOMPLETE_TEMPERATURE=0.2

# Timeout (seconds) for autocomplete model calls
AUTOCOMPLETE_TIMEOUT_SECONDS=3

# Your API key for the selected model's provider.
# For Gemini, this is your Google AI Studio API Key.
LLM_API_KEY="YOUR_API_KEY_HERE"

# Read implicitly by the Google ADK agent layer (backend/agent/agent.py).
# Usually the same Google AI Studio key as LLM_API_KEY.
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# Langfuse tracing. Read implicitly by langfuse.get_client() in agent/agent.py.
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
